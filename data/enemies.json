{
  "_schema": {
    "_comment": "Enemy configuration schema",
    "_fields": {
      "health": "number - Maximum health points",
      "speed": "number - Movement speed in pixels per second",
      "damage": "number - Attack damage dealt to player",
      "xpValue": "number - Experience points awarded when defeated",
      "attackCooldown": "number - Seconds between attacks",
      "attackRange": "number - Optional; ranged enemies stop this far short of the wall",
      "isBoss": "boolean - Optional; shows the boss health bar",
      "isFinalBoss": "boolean - Optional; killing it wins the run",
      "hasShield": "boolean - Optional; blocks projectiles until a piercing projectile breaks the shield",
      "slowImmune": "boolean - Optional; ignores slow and freeze",
      "explodeDamage": "number - Optional; explodes for this much wall damage on reaching the wall (no reward)",
      "splitInto": "string - Optional; enemy type it splits into when killed",
      "splitCount": "number - Optional; how many enemies it splits into",
      "phaseInterval": "number - Optional; seconds per phase cycle",
      "phaseDuration": "number - Optional; seconds untargetable at the end of each phase cycle",
      "summonInterval": "number - Optional; seconds between raising enemies",
      "summonCount": "number - Optional; enemies raised each time",
      "summonType": "string - Optional; enemy type raised (default swarmling)",
      "burrows": "boolean - Optional; untargetable underground until near the wall",
      "surfaceDistance": "number - Optional; surfaces this far short of its stop point",
      "name": "string - Optional; display name (shown in the boss banner)",
      "bossAbility": "string - Optional; a boss's attack ability: slam (double wall damage) or charge"
    }
  },
